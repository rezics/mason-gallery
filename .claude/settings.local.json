{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": ["."],
      "denyWrite": [
        "~/.ssh/**",
        "~/.gnupg/**",
        "~/.config/**",
        "~/.bashrc",
        "~/.zshrc"
      ],
      "denyRead": ["~/.ssh/**", "~/.gnupg/**"]
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git ls-tree:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:v2.tauri.app)",
      "WebFetch(domain:bun.com)",
      "WebFetch(domain:dev.to)",
      "Bash(openspec:*)",
      "Bash(openspec new:*)",
      "Bash(openspec status:*)",
      "Bash(openspec instructions:*)",
      "Bash(bun add:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx biome:*)",
      "Bash(. \"$HOME/.cargo/env\")",
      "Bash(bunx tauri:*)",
      "Bash(cargo check:*)",
      "Bash(cargo fmt:*)",
      "Bash(bun run:*)",
      "Bash(ls:*)"
    ],
    "deny": ["Bash(sudo:*)", "Bash(rm -rf /*)"]
  }
}
